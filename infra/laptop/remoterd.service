# Own user, no home, no desktop, no internet: even exploited, remoterd reaches
# nothing but the phone's address.
[Unit]
Description=remoter network daemon
After=network.target remoter-firewall.service
# Wants, not Requires: SO_BINDTODEVICE keeps the daemon off the LAN on its
# own, so a firewall that failed to load must not take remoterd down too.
Wants=remoter-firewall.service

[Service]
User=remoterd
Group=remoterd
ExecStart=/usr/local/bin/remoterd --config /etc/remoter/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
StateDirectory=remoterd
StateDirectoryMode=0711
# Holds admin.sock, which only root can reach.
RuntimeDirectory=remoterd
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
IPAddressDeny=any
IPAddressAllow=10.66.66.2/32
UMask=0077

[Install]
WantedBy=multi-user.target
